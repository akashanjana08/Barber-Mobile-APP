# =============================================================================
# BarberCraft Backend Environment Configuration
# =============================================================================

# Server Settings
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MongoDB Database Connection
# Replace with your local MongoDB URL or MongoDB Atlas Cloud Connection String
# e.g., mongodb+srv://<username>:<password>@cluster0.mongodb.net/barbercraft?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/barbercraft

# JWT Authentication
JWT_SECRET=barbercraft_super_secret_jwt_key_2026_x89q!
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=barbercraft_refresh_token_secret_key_2026_z89y!
REFRESH_TOKEN_EXPIRES_IN=30d

# =============================================================================
# THIRD-PARTY RESOURCES & INTEGRATION CONFIGURATION
# =============================================================================

# 1. Payment Gateway Configuration
# Options: 'razorpay' | 'stripe' | 'upi' | 'mock'
PAYMENT_PROVIDER=mock
PAYMENT_CURRENCY=INR

# Razorpay credentials (if PAYMENT_PROVIDER=razorpay)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_key

# Stripe credentials (if PAYMENT_PROVIDER=stripe)
STRIPE_SECRET_KEY=sk_test_placeholder_stripe_key
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_stripe_webhook

# 2. Push Notifications & SMS Service Configuration
# Options: 'firebase' | 'twilio' | 'mock'
NOTIFICATION_PROVIDER=mock

# Firebase Cloud Messaging (FCM) credentials
FCM_SERVER_KEY=firebase_server_key_placeholder
FIREBASE_PROJECT_ID=barbercraft-app-prod

# Twilio SMS credentials (for appointment reminder SMS)
TWILIO_ACCOUNT_SID=AC_placeholder_twilio_sid
TWILIO_AUTH_TOKEN=placeholder_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# 3. Maps & Geolocation Configuration
# Options: 'google' | 'mapbox' | 'mock'
MAPS_PROVIDER=mock
GOOGLE_MAPS_API_KEY=AIzaSy_placeholder_google_maps_key
DEFAULT_LATITUDE=28.6500
DEFAULT_LONGITUDE=77.4500

# 4. Email Service Configuration
# Options: 'sendgrid' | 'smtp' | 'mock'
EMAIL_PROVIDER=mock
SENDGRID_API_KEY=SG.placeholder_sendgrid_key
EMAIL_FROM=notifications@barbercraft.app

# 5. Real-Time Engine & Business Logic Configuration
REALTIME_TRANSPORT_MODE=WEBSOCKET
SLOT_HOLD_TIMEOUT_MINUTES=10
SLOT_RECOVERY_DISCOUNT_PERCENT=20
APPOINTMENT_REMINDER_MINUTES_BEFORE=15
MAX_SEARCH_RADIUS_KM=15.0
